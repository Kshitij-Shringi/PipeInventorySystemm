# Comma-separated browser origins (scheme + host, no trailing slash).
# Leave unset to use defaults (localhost + https://pinventory.pedalsupclients.xyz).
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Optional regex for extra origins (overrides CORS_PEDALSUP_SUBDOMAINS when set).
# CORS_ORIGIN_REGEX=https://[\w-]+\.pedalsupclients\.xyz

# Set to false to disable auto-allowing https://*.pedalsupclients.xyz
# CORS_PEDALSUP_SUBDOMAINS=true